{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.yue.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@lang": [
        "./src/lang/yue/index.ts"
      ],
      "@lang/*": [
        "./src/lang/yue/*"
      ],
      "@content/*": [
        "./content/yue/*"
      ]
    }
  },
  "include": [
    "src",
    "tests/course-yue",
    "content/**/*.d.ts"
  ],
  "exclude": [
    "src/lang/es",
    "src/lang/pt",
    "src/lang/it"
  ]
}
